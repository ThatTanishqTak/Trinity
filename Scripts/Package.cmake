# Packages Trinity's Release and Distribution builds as an engine version: Trinity-<version>-<platform>-<architecture>.zip, which Hub installs, with a .sha256 beside it, and the debug symbols of its Release programs in the same name's -symbols.zip, which Hub never installs. Run it from anywhere with
#   cmake [-DPRESET=<configure preset>] [-DBUILD=OFF] [-DALLOW_CHANGES=ON] [-DOUTPUT=<folder>] -P Scripts/Package.cmake
# PRESET names the configure preset whose builds are packaged, by default the first of this platform's that has been configured. BUILD=OFF packages the builds already in bin rather than building Release and Distribution through the preset first. ALLOW_CHANGES=ON packages the builds of a tree with changes, which is refused otherwise. OUTPUT is where the packages go, out/Packages by default. The same builds give the same bytes each time they are packaged by the same user, its files sorted and their times the commit's
cmake_minimum_required(VERSION 3.30...4.2)

get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)

if(NOT DEFINED BUILD)
    set(BUILD ON)
endif()

if(NOT DEFINED ALLOW_CHANGES)
    set(ALLOW_CHANGES OFF)
endif()

if(NOT DEFINED OUTPUT)
    set(OUTPUT "${root}/out/Packages")
endif()
get_filename_component(OUTPUT "${OUTPUT}" ABSOLUTE)

# The presets of this platform, the first that has been configured being the one packaged unless PRESET names another
if(CMAKE_HOST_WIN32)
    set(presets windows-vs2026 windows-ninja)
elseif(CMAKE_HOST_APPLE)
    message(FATAL_ERROR "Packaging Trinity for macOS comes with milestone M14")
else()
    set(presets linux-clang linux-gcc)
endif()

if(NOT DEFINED PRESET)
    list(GET presets 0 PRESET)
    foreach(preset IN LISTS presets)
        if(EXISTS "${root}/out/${preset}/CMakeCache.txt")
            set(PRESET "${preset}")
            break()
        endif()
    endforeach()
endif()

set(build_tree "${root}/out/${PRESET}")
message(STATUS "Package: Trinity's ${PRESET} builds")

function(trinity_run)
    execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${root}" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        list(JOIN ARGN " " command)
        message(FATAL_ERROR "Package: ${command} failed, so nothing is packaged")
    endif()
endfunction()

# Sets this process's environment, which the builds it starts inherit, from cmd's set: a NAME=VALUE a line, of which only names a variable can have are taken
function(trinity_take_environment text)
    string(REPLACE "\r\n" "\n" text "${text}")
    while(NOT text STREQUAL "")
        string(FIND "${text}" "\n" end)
        if(end EQUAL -1)
            set(line "${text}")
            set(text "")
        else()
            string(SUBSTRING "${text}" 0 ${end} line)
            math(EXPR next "${end} + 1")
            string(SUBSTRING "${text}" ${next} -1 text)
        endif()

        string(FIND "${line}" "=" equals)
        if(equals GREATER 0)
            string(SUBSTRING "${line}" 0 ${equals} variable)
            math(EXPR value_start "${equals} + 1")
            string(SUBSTRING "${line}" ${value_start} -1 value)
            if(variable MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
                set(ENV{${variable}} "${value}")
            endif()
        endif()
    endwhile()
endfunction()

# A Ninja preset on Windows names its compiler as cl, which only Visual Studio's environment puts on the PATH, as its Open Folder and developer consoles do. Outside them the packaging takes that environment from vcvars64.bat, as Forge's module builds do: of the Visual Studio whose cl the build tree was configured with, at that toolset, or else of the latest Visual Studio with the C++ tools
function(trinity_enter_msvc_environment)
    find_program(cl_found cl.exe NO_CACHE)
    if(cl_found)
        return()
    endif()

    set(vcvars "")
    set(toolset "")
    file(GLOB compiler_files "${build_tree}/CMakeFiles/*/CMakeCXXCompiler.cmake")
    list(SORT compiler_files COMPARE NATURAL ORDER DESCENDING)
    foreach(compiler_file IN LISTS compiler_files)
        file(STRINGS "${compiler_file}" compiler_line REGEX "^set\\(CMAKE_CXX_COMPILER \"")
        if(compiler_line MATCHES "\"(.+)/VC/Tools/MSVC/([^/]+)/bin/[^\"]+/cl\\.exe\"")
            set(installation "${CMAKE_MATCH_1}")
            set(installation_toolset "${CMAKE_MATCH_2}")
            if(EXISTS "${installation}/VC/Auxiliary/Build/vcvars64.bat")
                set(vcvars "${installation}/VC/Auxiliary/Build/vcvars64.bat")
                set(toolset "${installation_toolset}")
                break()
            endif()
        endif()
    endforeach()

    if(vcvars STREQUAL "")
        file(TO_CMAKE_PATH "$ENV{ProgramFiles\(x86\)}" program_files)
        if(program_files STREQUAL "")
            set(program_files "C:/Program Files (x86)")
        endif()

        set(installation "")
        if(EXISTS "${program_files}/Microsoft Visual Studio/Installer/vswhere.exe")
            execute_process(COMMAND "${program_files}/Microsoft Visual Studio/Installer/vswhere.exe" -latest -prerelease -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath OUTPUT_VARIABLE installation OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        endif()

        if(installation STREQUAL "")
            message(FATAL_ERROR "Package: cl is not on the PATH, and no Visual Studio with its C++ tools was found to take it from. Install the Desktop development with C++ workload, or run this from a Visual Studio developer console")
        endif()

        file(TO_CMAKE_PATH "${installation}" installation)
        set(vcvars "${installation}/VC/Auxiliary/Build/vcvars64.bat")
    endif()

    # A batch file that runs vcvars64.bat, then lists every variable it leaves
    set(toolset_option "")
    if(NOT toolset STREQUAL "")
        set(toolset_option " -vcvars_ver=${toolset}")
    endif()

    file(TO_NATIVE_PATH "${vcvars}" vcvars_native)
    set(batch "${build_tree}/TrinityPackageEnvironment.bat")
    file(WRITE "${batch}" "@call \"${vcvars_native}\"${toolset_option} >nul\r\n@if errorlevel 1 exit /b 1\r\n@set\r\n")
    file(TO_NATIVE_PATH "${batch}" batch_native)
    set(shell "$ENV{ComSpec}")
    if(shell STREQUAL "")
        set(shell "C:/Windows/System32/cmd.exe")
    endif()

    execute_process(COMMAND "${shell}" /d /c "${batch_native}" OUTPUT_VARIABLE environment RESULT_VARIABLE result ERROR_QUIET)
    file(REMOVE "${batch}")
    if(NOT result EQUAL 0 OR NOT environment MATCHES "(^|\n)INCLUDE=")
        message(FATAL_ERROR "Package: ${vcvars} did not set up the compiler, so the builds cannot run. Run this from a Visual Studio developer console instead")
    endif()

    trinity_take_environment("${environment}")
    # Visual Studio's messages in English, as Forge asks for them
    set(ENV{VSLANG} 1033)
    if(toolset STREQUAL "")
        message(STATUS "Package: using the compiler environment of ${vcvars}")
    else()
        message(STATUS "Package: using the compiler environment of ${vcvars} at toolset ${toolset}")
    endif()

    find_program(cl_found cl.exe NO_CACHE)
    if(NOT cl_found)
        message(FATAL_ERROR "Package: ${vcvars} left no cl on the PATH, so the builds cannot run. Run this from a Visual Studio developer console instead")
    endif()
endfunction()

