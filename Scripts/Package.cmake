# The kinds the summary lists, each file of the version counted under one, whose bytes and files are kept as global properties so every function adds to the same counts
set(kinds Programs Libraries Headers Scripting Shaders Fonts Runtimes Packages Templates Notices)
foreach(kind IN LISTS kinds)
    set_property(GLOBAL PROPERTY TRINITY_PACKAGE_BYTES_${kind} 0)
    set_property(GLOBAL PROPERTY TRINITY_PACKAGE_FILES_${kind} 0)
endforeach()

function(trinity_count path kind)
    file(SIZE "${path}" size)
    get_property(bytes GLOBAL PROPERTY TRINITY_PACKAGE_BYTES_${kind})
    get_property(files GLOBAL PROPERTY TRINITY_PACKAGE_FILES_${kind})
    math(EXPR bytes "${bytes} + ${size}")
    math(EXPR files "${files} + 1")
    set_property(GLOBAL PROPERTY TRINITY_PACKAGE_BYTES_${kind} ${bytes})
    set_property(GLOBAL PROPERTY TRINITY_PACKAGE_FILES_${kind} ${files})
endfunction()

# A file of a build into the version, counted under kind
function(trinity_take source destination kind)
    cmake_path(GET destination PARENT_PATH folder)
    file(MAKE_DIRECTORY "${folder}")
    file(COPY_FILE "${source}" "${destination}" RESULT result)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Package: ${source} could not be copied into the version: ${result}")
    endif()

    trinity_count("${destination}" ${kind})
endfunction()

# Every file under a folder of a build whose path below it no EXCLUDE expression matches, into the same place in the version
function(trinity_take_folder source destination kind)
    cmake_parse_arguments(PARSE_ARGV 3 take "" "" "EXCLUDE")
    file(GLOB_RECURSE files RELATIVE "${source}" "${source}/*")
    foreach(file IN LISTS files)
        set(excluded OFF)
        foreach(exclusion IN LISTS take_EXCLUDE)
            if(file MATCHES "${exclusion}")
                set(excluded ON)
            endif()
        endforeach()

        if(NOT excluded)
            trinity_take("${source}/${file}" "${destination}/${file}" ${kind})
        endif()
    endforeach()
endfunction()

# A Release program into the version, with its debug symbols into the symbols' folder at the same place: on Windows its .pdb, and elsewhere its debug sections split into <name>.debug, which the shipped copy names through a debug link, so a debugger finds them once the symbols are unzipped over the version
function(trinity_take_program source destination kind)
    cmake_path(GET source FILENAME program)
    cmake_path(GET destination PARENT_PATH folder)
    file(RELATIVE_PATH relative "${stage}" "${folder}")
    file(MAKE_DIRECTORY "${folder}" "${symbols_stage}/${relative}")
    if(TRINITY_VERSION_PLATFORM STREQUAL "Windows")
        trinity_take("${source}" "${destination}" ${kind})
        cmake_path(REPLACE_EXTENSION source ".pdb" OUTPUT_VARIABLE pdb)
        if(EXISTS "${pdb}")
            cmake_path(GET pdb FILENAME pdb_name)
            file(COPY_FILE "${pdb}" "${symbols_stage}/${relative}/${pdb_name}")
        endif()

        return()
    endif()

    set(debug "${symbols_stage}/${relative}/${program}.debug")
    execute_process(COMMAND "${objcopy}" --only-keep-debug "${source}" "${debug}" RESULT_VARIABLE result)
    if(result EQUAL 0)
        execute_process(COMMAND "${objcopy}" --strip-debug "--add-gnu-debuglink=${debug}" "${source}" "${destination}" RESULT_VARIABLE result)
    endif()

    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Package: the debug symbols of ${source} could not be split out with ${objcopy}")
    endif()

    trinity_count("${destination}" ${kind})
endfunction()

