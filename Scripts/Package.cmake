# Sizes as Forge's Console shows them
function(trinity_format_bytes bytes out)
    if(bytes LESS 1024)
        set(${out} "${bytes} B" PARENT_SCOPE)
        return()
    endif()

    set(unit KiB)
    set(scale 1024)
    if(bytes GREATER_EQUAL 1073741824)
        set(unit GiB)
        set(scale 1073741824)
    elseif(bytes GREATER_EQUAL 1048576)
        set(unit MiB)
        set(scale 1048576)
    endif()

    math(EXPR whole "${bytes} / ${scale}")
    math(EXPR hundredths "(${bytes} % ${scale}) * 100 / ${scale}")
    if(hundredths LESS 10)
        set(hundredths "0${hundredths}")
    endif()
    set(${out} "${whole}.${hundredths} ${unit}" PARENT_SCOPE)
endfunction()

