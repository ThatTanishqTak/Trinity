# The third-party notice of a version, ThirdPartyNotices.txt, which Scripts/Package.cmake includes: every library of Scripts/Vendor.lock, the code those libraries bundle that Trinity's build compiles in, and what a version carries from outside the submodules, each with the licence it is used under, by its SPDX identifier, and that licence's text as the project gives it. A library of Vendor.lock without an entry here, or an entry's file that is missing, stops the packaging, so the notice never leaves one out. A text given before in the same file is named rather than given again

# Adds one project to the notice: its title, its licence's SPDX identifier, where it comes from, its folder, under the repository unless it is a whole path, and its licence's files there. A file written as <file>:<lines> gives only its first lines, for a licence kept in a source file's opening comment. With no files, where says where its terms are
function(trinity_notice title spdx where folder)
    get_property(text GLOBAL PROPERTY TRINITY_NOTICE_TEXT)
    string(APPEND text "================================================================================\n${title}\nLicence: ${spdx}\nFrom: ${where}\n--------------------------------------------------------------------------------\n")
    foreach(file IN LISTS ARGN)
        set(lines "")
        if(file MATCHES "^(.+):([0-9]+)$")
            set(file "${CMAKE_MATCH_1}")
            set(lines "${CMAKE_MATCH_2}")
        endif()

        if(IS_ABSOLUTE "${folder}")
            set(path "${folder}/${file}")
        else()
            set(path "${root}/${folder}/${file}")
        endif()

        if(NOT EXISTS "${path}")
            message(FATAL_ERROR "Package: ${title}'s licence is not at ${path}, which Scripts/PackageNotices.cmake names")
        endif()

        file(READ "${path}" licence)
        string(REPLACE "\r\n" "\n" licence "${licence}")
        if(lines)
            set(kept "")
            foreach(index RANGE 1 ${lines})
                string(FIND "${licence}" "\n" end)
                if(end EQUAL -1)
                    string(APPEND kept "${licence}")
                    set(licence "")
                    break()
                endif()

                math(EXPR length "${end} + 1")
                string(SUBSTRING "${licence}" 0 ${length} line)
                string(SUBSTRING "${licence}" ${length} -1 licence)
                string(APPEND kept "${line}")
            endforeach()
            set(licence "${kept}")
        endif()

        if(NOT licence MATCHES "\n$")
            string(APPEND licence "\n")
        endif()

        string(SHA256 hash "${licence}")
        get_property(given GLOBAL PROPERTY TRINITY_NOTICE_GIVEN_${hash})
        if(given)
            string(APPEND text "${file}: the same text as ${given}, above.\n\n")
        else()
            set_property(GLOBAL PROPERTY TRINITY_NOTICE_GIVEN_${hash} "${title}'s ${file}")
            set_property(GLOBAL APPEND PROPERTY TRINITY_NOTICE_HASHES "${hash}")
            string(APPEND text "${licence}\n")
        endif()
    endforeach()

    if(NOT ARGN)
        string(APPEND text "\n")
    endif()

    set_property(GLOBAL PROPERTY TRINITY_NOTICE_TEXT "${text}")
endfunction()

# One of Vendor.lock's libraries, under its name there, with its pin and fork as the lock gives them
function(trinity_vendor_notice name spdx)
    if(NOT DEFINED vendor_${name})
        message(FATAL_ERROR "Package: Scripts/PackageNotices.cmake names ${name}, which Scripts/Vendor.lock does not")
    endif()

    set_property(GLOBAL APPEND PROPERTY TRINITY_NOTICE_VENDORS "${name}")
    trinity_notice("${name} ${vendor_tag_${name}}" "${spdx}" "${vendor_${name}}" "Vendor/${name}" ${ARGN})
endfunction()

# Code a Vendor.lock library bundles and Trinity's build compiles in
function(trinity_bundled_notice title library spdx folder)
    trinity_notice("${title}, in ${library}" "${spdx}" "Bundled with ${library}, in its ${folder}" "Vendor/${library}/${folder}" ${ARGN})
endfunction()

# The notice as a file, every text in it given there, as each file is read apart from any other. HUB writes Hub's, headed with Hub's own version, and without Microsoft's C++ runtime, whose DLLs Hub does not carry
function(trinity_write_notices path)
    cmake_parse_arguments(PARSE_ARGV 1 notices "HUB" "" "")
    get_property(given_hashes GLOBAL PROPERTY TRINITY_NOTICE_HASHES)
    foreach(hash IN LISTS given_hashes)
        set_property(GLOBAL PROPERTY TRINITY_NOTICE_GIVEN_${hash} "")
    endforeach()
    set_property(GLOBAL PROPERTY TRINITY_NOTICE_HASHES "")

    set(heading "Third-party notices for Trinity ${TRINITY_VERSION}\n\nTrinity's programs, libraries and headers in this version include code of the projects below.")
    if(notices_HUB)
        set(heading "Third-party notices for Trinity Hub ${TRINITY_HUB_VERSION}\n\nTrinity Hub, built on Trinity ${TRINITY_VERSION}, includes code of the projects below, as every library of the engine is linked into it.")
    endif()

    set_property(GLOBAL PROPERTY TRINITY_NOTICE_TEXT "${heading} Each is listed with the licence it is used under, by its SPDX identifier, and that licence's text as the project gives it. Where a project offers a choice of licences, the first is the one used.\n\n")
    set_property(GLOBAL PROPERTY TRINITY_NOTICE_VENDORS "")

    # Each line of the lock: name, fork, commit, then the tag or branch it is pinned at
    file(STRINGS "${root}/Scripts/Vendor.lock" lock_lines)
    set(vendors "")
    foreach(line IN LISTS lock_lines)
        if(line MATCHES "^([^# ][^ ]*) ([^ ]+) ([0-9a-f]+) (.*)$")
            set(vendor_${CMAKE_MATCH_1} "${CMAKE_MATCH_2} at ${CMAKE_MATCH_3}")
            set(vendor_tag_${CMAKE_MATCH_1} "${CMAKE_MATCH_4}")
            list(APPEND vendors "${CMAKE_MATCH_1}")
        endif()
    endforeach()

    trinity_vendor_notice(spdlog MIT LICENSE)
    trinity_vendor_notice(glm "MIT" copying.txt)
    trinity_vendor_notice(entt MIT LICENSE)
    trinity_vendor_notice(yaml-cpp MIT LICENSE)
    trinity_vendor_notice(JoltPhysics MIT LICENSE)
    trinity_vendor_notice(box2d MIT LICENSE)
    trinity_vendor_notice(imgui MIT LICENSE.txt)
    trinity_vendor_notice(ImGuizmo MIT LICENSE)
    trinity_vendor_notice(stb "MIT OR Unlicense" LICENSE)
    trinity_vendor_notice(miniaudio "MIT-0 OR Unlicense" LICENSE)
    trinity_vendor_notice(simdjson "Apache-2.0 OR MIT" LICENSE LICENSE-MIT)
    trinity_vendor_notice(fastgltf MIT LICENSE.md)
    trinity_vendor_notice(meshoptimizer MIT LICENSE.md)
    trinity_vendor_notice(assimp BSD-3-Clause LICENSE)
    trinity_bundled_notice(zlib assimp Zlib contrib/zlib LICENSE)
    trinity_bundled_notice(minizip assimp Zlib contrib/unzip unzip.h:41)
    trinity_bundled_notice(pugixml assimp MIT contrib/pugixml LICENSE.md)
    trinity_bundled_notice(utf8cpp assimp BSL-1.0 contrib/utf8cpp doc/LICENSE)
    trinity_bundled_notice(poly2tri assimp BSD-3-Clause contrib/poly2tri LICENSE)
    trinity_bundled_notice(OpenDDL-Parser assimp MIT contrib/openddlparser LICENSE)
    trinity_bundled_notice(Open3DGC assimp MIT contrib/Open3DGC o3dgcCommon.h:21)
    trinity_vendor_notice(freetype FTL LICENSE.TXT docs/FTL.TXT)
    trinity_vendor_notice(RmlUi MIT LICENSE.txt)
    trinity_bundled_notice("robin_hood and itlib" RmlUi MIT Include/RmlUi/Core/Containers LICENSE.txt)
    trinity_vendor_notice(Vulkan-Headers "Apache-2.0 OR MIT" LICENSE.md LICENSES/Apache-2.0.txt LICENSES/MIT.txt)
    trinity_vendor_notice(volk MIT LICENSE.md)
    trinity_vendor_notice(VulkanMemoryAllocator MIT LICENSE.txt)
    trinity_vendor_notice(DirectX-Headers MIT LICENSE)
    trinity_vendor_notice(D3D12MemoryAllocator MIT LICENSE.txt NOTICES.txt)
    trinity_vendor_notice(KTX-Software Apache-2.0 LICENSE.md LICENSES/Apache-2.0.txt)
    trinity_bundled_notice("Basis Universal" KTX-Software Apache-2.0 external/basisu LICENSE)
    trinity_bundled_notice(zstd KTX-Software BSD-3-Clause external/basisu/zstd LICENSE)
    trinity_bundled_notice(astc-encoder KTX-Software Apache-2.0 external/astc-encoder LICENSE.txt)
    trinity_bundled_notice(dfdutils KTX-Software Apache-2.0 external/dfdutils LICENSE.adoc)

    get_property(named GLOBAL PROPERTY TRINITY_NOTICE_VENDORS)
    foreach(vendor IN LISTS vendors)
        if(NOT vendor IN_LIST named)
            message(FATAL_ERROR "Package: ${vendor}, in Scripts/Vendor.lock, has no licence in Scripts/PackageNotices.cmake. Add it there with the licence it is used under")
        endif()
    endforeach()

    # From outside the submodules: the fonts the engine draws its UI with, the .NET host the engine starts C# through, and on Windows the D3D12 runtime, GameInput and Microsoft's C++ runtime
    trinity_notice("JetBrains Mono Nerd Font Propo" OFL-1.1 "Trinity-Engine/Assets/Fonts, in Engine/fonts" "Trinity-Engine/Assets/Fonts" OFL.txt)

    file(STRINGS "${build_tree}/CMakeCache.txt" dotnet_line REGEX "^TRINITY_DOTNET:FILEPATH=")
    string(REGEX REPLACE "^TRINITY_DOTNET:FILEPATH=" "" dotnet "${dotnet_line}")
    if(EXISTS "${release_from}/Scripting" AND EXISTS "${dotnet}")
        file(REAL_PATH "${dotnet}" dotnet)
        cmake_path(GET dotnet PARENT_PATH dotnet_root)
        trinity_notice(".NET host (nethost)" MIT "The .NET SDK Trinity was built with, whose nethost the engine starts .NET through" "${dotnet_root}" LICENSE.txt)
    endif()

    if(TRINITY_VERSION_PLATFORM STREQUAL "Windows")
        foreach(package IN ITEMS AgilitySDK GameInput)
            file(STRINGS "${root}/Scripts/${package}.lock" package_line REGEX "^Microsoft\\.")
            string(REGEX REPLACE "^([^ ]+) ([^ ]+) .*$" "\\1;\\2" package_fields "${package_line}")
            list(GET package_fields 0 package_name)
            list(GET package_fields 1 package_version)
            file(GLOB package_licences RELATIVE "${root}/Vendor/${package}/${package_version}" "${root}/Vendor/${package}/${package_version}/*")
            list(FILTER package_licences INCLUDE REGEX "([Ll][Ii][Cc][Ee][Nn][Ss][Ee]|[Nn][Oo][Tt][Ii][Cc][Ee]|[Ee][Uu][Ll][Aa])")
            if(NOT package_licences)
                message(FATAL_ERROR "Package: Vendor/${package}/${package_version} holds no licence of ${package_name}. Run Scripts/Bootstrap.ps1 again")
            endif()

            list(SORT package_licences)
            trinity_notice("${package_name} ${package_version}" "LicenseRef-Microsoft-${package}" "The NuGet package ${package_name} ${package_version}, as Scripts/${package}.lock pins it" "Vendor/${package}/${package_version}" ${package_licences})
        endforeach()

        file(GLOB msvc_runtime "${release_from}/msvcp140*.dll" "${release_from}/vcruntime140*.dll")
        if(msvc_runtime AND NOT notices_HUB)
            trinity_notice("Microsoft Visual C++ runtime" "LicenseRef-Microsoft-Visual-Studio-Distributable-Code" "Visual Studio's redistributable folder. Its DLLs beside Release's programs are Distributable Code under the Microsoft Visual Studio license terms, which let a program carry them" "")
        endif()
    endif()

    get_property(text GLOBAL PROPERTY TRINITY_NOTICE_TEXT)
    file(WRITE "${path}" "${text}")
endfunction()