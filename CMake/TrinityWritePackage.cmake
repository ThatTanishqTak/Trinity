# Run with cmake -P by the build as each configuration's build ends, given TRINITY_PACKAGE_FILES, which CMake/TrinityPackage.cmake writes for the configuration. Copies into the version what its packages name, each file only when it differs, and removes what the version no longer holds: the headers into Include, the allocations source into Source, the project templates into Templates, and in Distribution the player's main objects into RuntimeMain, the checks a player's build makes into CMake and the libraries from outside Trinity's build beside the static engine, then writes TrinityGameTargets.cmake there from CMake's export of the static engine, naming only what the version holds
cmake_minimum_required(VERSION 3.30...4.2)

include("${TRINITY_PACKAGE_FILES}")

# Copies source to destination when the destination is missing or differs, keeping the destination's time when it is the same, so nothing builds again for it
function(trinity_copy_if_different source destination)
    cmake_path(GET destination PARENT_PATH directory)
    file(MAKE_DIRECTORY "${directory}")
    file(COPY_FILE "${source}" "${destination}" ONLY_IF_DIFFERENT RESULT result)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "${source} could not be copied to ${destination}: ${result}")
    endif()
endfunction()

function(trinity_write_if_different path text)
    if(EXISTS "${path}")
        file(READ "${path}" existing)
        if(existing STREQUAL text)
            return()
        endif()
    endif()

    cmake_path(GET path PARENT_PATH directory)
    file(MAKE_DIRECTORY "${directory}")
    file(WRITE "${path}" "${text}")
endfunction()

# Removes every file under folder that is not named in the list, so a header or object taken out of Trinity's build leaves the version too
function(trinity_remove_others folder)
    foreach(kept IN LISTS ARGN)
        set("kept:${kept}" ON)
    endforeach()

    file(GLOB_RECURSE present LIST_DIRECTORIES false "${folder}/*")
    foreach(file IN LISTS present)
        if(NOT DEFINED "kept:${file}")
            file(REMOVE "${file}")
        endif()
    endforeach()
endfunction()

# The engine's interface may include only folders a version holds, which TRINITY_PACKAGE_INCLUDE_ROOTS in CMake/TrinityPackage.cmake lists
set(include_sources "")
set(include_destinations "")
list(LENGTH TRINITY_PACKAGE_INCLUDE_ROOTS root_count)
math(EXPR last_root "${root_count} - 1")
foreach(index RANGE 0 ${last_root} 2)
    math(EXPR destination_index "${index} + 1")
    list(GET TRINITY_PACKAGE_INCLUDE_ROOTS ${index} include_source)
    list(GET TRINITY_PACKAGE_INCLUDE_ROOTS ${destination_index} include_destination)
    list(APPEND include_sources "${include_source}")
    list(APPEND include_destinations "${include_destination}")
endforeach()

foreach(include IN LISTS TRINITY_PACKAGE_ENGINE_INCLUDES)
    if(NOT include IN_LIST include_sources)
        message(FATAL_ERROR "The engine's interface includes ${include}, which a version of Trinity does not hold, so no module or player could build against it once the version is moved. Add it to TRINITY_PACKAGE_INCLUDE_ROOTS and its headers to TRINITY_PACKAGE_HEADERS in CMake/TrinityPackage.cmake")
    endif()
endforeach()

# The headers: each set is a folder, then where it goes in the version, then whether its subfolders go too
set(headers "")
list(LENGTH TRINITY_PACKAGE_HEADERS header_count)
math(EXPR last_header "${header_count} - 1")
foreach(index RANGE 0 ${last_header} 3)
    math(EXPR destination_index "${index} + 1")
    math(EXPR recurse_index "${index} + 2")
    list(GET TRINITY_PACKAGE_HEADERS ${index} header_source)
    list(GET TRINITY_PACKAGE_HEADERS ${destination_index} header_destination)
    list(GET TRINITY_PACKAGE_HEADERS ${recurse_index} header_recurse)
    if(header_recurse)
        file(GLOB_RECURSE header_files RELATIVE "${header_source}" "${header_source}/*.hpp" "${header_source}/*.h" "${header_source}/*.inl")
    else()
        file(GLOB header_files RELATIVE "${header_source}" "${header_source}/*.hpp" "${header_source}/*.h" "${header_source}/*.inl")
    endif()

    if(NOT header_files)
        message(FATAL_ERROR "${header_source} holds no headers for the version's ${header_destination}")
    endif()

    foreach(header IN LISTS header_files)
        trinity_copy_if_different("${header_source}/${header}" "${TRINITY_PACKAGE_ROOT}/${header_destination}/${header}")
        list(APPEND headers "${TRINITY_PACKAGE_ROOT}/${header_destination}/${header}")
    endforeach()
endforeach()
trinity_remove_others("${TRINITY_PACKAGE_ROOT}/Include" ${headers})

set(sources "")
foreach(source IN LISTS TRINITY_PACKAGE_SOURCES)
    cmake_path(GET source FILENAME source_name)
    trinity_copy_if_different("${source}" "${TRINITY_PACKAGE_ROOT}/Source/${source_name}")
    list(APPEND sources "${TRINITY_PACKAGE_ROOT}/Source/${source_name}")
endforeach()
trinity_remove_others("${TRINITY_PACKAGE_ROOT}/Source" ${sources})

# The project templates whole, which Forge's --template and Hub's New Project find in the version
set(templates "")
if(IS_DIRECTORY "${TRINITY_PACKAGE_TEMPLATES}")
    file(GLOB_RECURSE template_files LIST_DIRECTORIES false RELATIVE "${TRINITY_PACKAGE_TEMPLATES}" "${TRINITY_PACKAGE_TEMPLATES}/*")
    foreach(template_file IN LISTS template_files)
        trinity_copy_if_different("${TRINITY_PACKAGE_TEMPLATES}/${template_file}" "${TRINITY_PACKAGE_ROOT}/Templates/${template_file}")
        list(APPEND templates "${TRINITY_PACKAGE_ROOT}/Templates/${template_file}")
    endforeach()
endif()
trinity_remove_others("${TRINITY_PACKAGE_ROOT}/Templates" ${templates})

if(NOT TRINITY_PACKAGE_GAME)
    return()
endif()

# The player's main, by the objects' own names, which TrinityConfig.cmake names them by too
set(objects "")
foreach(object IN LISTS TRINITY_PACKAGE_OBJECTS)
    cmake_path(GET object FILENAME object_name)
    if("${TRINITY_PACKAGE_DIRECTORY}/RuntimeMain/${object_name}" IN_LIST objects)
        message(FATAL_ERROR "Two of the player's main objects are named ${object_name}, which the game package's RuntimeMain folder cannot hold both of. Rename one of Trinity-Runtime's sources")
    endif()

    trinity_copy_if_different("${object}" "${TRINITY_PACKAGE_DIRECTORY}/RuntimeMain/${object_name}")
    list(APPEND objects "${TRINITY_PACKAGE_DIRECTORY}/RuntimeMain/${object_name}")
endforeach()
trinity_remove_others("${TRINITY_PACKAGE_DIRECTORY}/RuntimeMain" ${objects})

set(checks "")
foreach(check IN LISTS TRINITY_PACKAGE_PLAYER_CHECKS)
    cmake_path(GET check FILENAME check_name)
    trinity_copy_if_different("${check}" "${TRINITY_PACKAGE_DIRECTORY}/CMake/${check_name}")
    list(APPEND checks "${TRINITY_PACKAGE_DIRECTORY}/CMake/${check_name}")
endforeach()
trinity_remove_others("${TRINITY_PACKAGE_DIRECTORY}/CMake" ${checks})

foreach(library IN LISTS TRINITY_PACKAGE_LIBRARIES)
    if(EXISTS "${library}")
        cmake_path(GET library FILENAME library_name)
        trinity_copy_if_different("${library}" "${TRINITY_PACKAGE_DIRECTORY}/${library_name}")
    endif()
endforeach()

file(READ "${TRINITY_PACKAGE_EXPORT}" exported)

# Only this configuration's locations: each other configuration's block runs from its comment to the blank line after it
set(text "")
set(rest "${exported}")
while(TRUE)
    string(FIND "${rest}" "# Import target \"" block_start)
    if(block_start EQUAL -1)
        string(APPEND text "${rest}")
        break()
    endif()

    string(SUBSTRING "${rest}" 0 ${block_start} before)
    string(APPEND text "${before}")
    string(SUBSTRING "${rest}" ${block_start} -1 rest)
    string(FIND "${rest}" "\n\n" block_end)
    if(block_end EQUAL -1)
        message(FATAL_ERROR "${TRINITY_PACKAGE_EXPORT} has a configuration's block with no end, which CMake/TrinityWritePackage.cmake does not know")
    endif()

    math(EXPR block_length "${block_end} + 2")
    string(SUBSTRING "${rest}" 0 ${block_length} block)
    string(SUBSTRING "${rest}" ${block_length} -1 rest)
    if(block MATCHES "^# Import target \"[^\"]+\" for configuration \"${TRINITY_PACKAGE_CONFIGURATION}\"\n")
        string(APPEND text "${block}")
    endif()
endwhile()

# Each target's include folders as the version holds them, and none for those only linked, whose headers no player includes. The property stays, empty, since it may be the only one a target sets
set(include_key "  INTERFACE_INCLUDE_DIRECTORIES \"")
string(LENGTH "${include_key}" include_key_length)
set(rest "${text}")
set(text "")
while(TRUE)
    string(FIND "${rest}" "${include_key}" key_start)
    if(key_start EQUAL -1)
        string(APPEND text "${rest}")
        break()
    endif()

    string(SUBSTRING "${rest}" 0 ${key_start} before)
    string(APPEND text "${before}")
    math(EXPR value_start "${key_start} + ${include_key_length}")
    string(SUBSTRING "${rest}" ${value_start} -1 rest)
    string(FIND "${rest}" "\"\n" value_end)
    string(SUBSTRING "${rest}" 0 ${value_end} value)
    math(EXPR after "${value_end} + 2")
    string(SUBSTRING "${rest}" ${after} -1 rest)

    set(kept "")
    foreach(include IN LISTS value)
        list(FIND include_sources "${include}" include_index)
        if(NOT include_index EQUAL -1)
            list(GET include_destinations ${include_index} include_destination)
            list(APPEND kept "\${TRINITY_ROOT}/${include_destination}")
        endif()
    endforeach()

    list(JOIN kept ";" joined)
    string(APPEND text "${include_key}${joined}\"\n")
endwhile()

# The static engine and its libraries are beside this file, as are the copies of those from outside Trinity's build
string(REPLACE "${TRINITY_PACKAGE_DIRECTORY}/" "\${CMAKE_CURRENT_LIST_DIR}/" text "${text}")
foreach(library IN LISTS TRINITY_PACKAGE_LIBRARIES)
    cmake_path(GET library FILENAME library_name)
    string(REPLACE "${library}" "\${CMAKE_CURRENT_LIST_DIR}/${library_name}" text "${text}")
endforeach()

foreach(root IN LISTS TRINITY_PACKAGE_FOREIGN_ROOTS)
    string(FIND "${text}" "${root}" foreign)
    if(NOT foreign EQUAL -1)
        string(SUBSTRING "${text}" ${foreign} 200 named)
        message(FATAL_ERROR "The game package would still name ${root}, which a version moved elsewhere does not have, at: ${named}")
    endif()
endforeach()

trinity_write_if_different("${TRINITY_PACKAGE_DIRECTORY}/TrinityGameTargets.cmake" "# Written by CMake/TrinityWritePackage.cmake from CMake's export of the static engine, with only the ${TRINITY_PACKAGE_CONFIGURATION} configuration's locations, each beside this file, and the include folders of the version that TrinityConfig.cmake finds as TRINITY_ROOT\n${text}")