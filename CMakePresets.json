{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/out/${presetName}",
      "cacheVariables": {
        "TRINITY_WARNINGS_AS_ERRORS": "OFF",
        "TRINITY_ENABLE_LTO": "OFF",
        "TRINITY_TRACK_GLOBAL_ALLOCATIONS": "ON",
        "TRINITY_ENABLE_PROFILING": "ON",
        "TRINITY_SHARED_ENGINE": "ON"
      }
    },
    {
      "name": "windows-vs2026",
      "displayName": "Windows - Visual Studio 2026 solution",
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "description": "Generates out/windows-vs2026/Trinity.sln(x). Needs CMake 4.2 or newer (the generator does not exist in 3.30).",
      "architecture": "x64"
    },
    {
      "name": "windows-ninja",
      "displayName": "Windows - Ninja + MSVC",
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "description": "Works with CMake 3.30. Used by Visual Studio's Open Folder mode, or from a Developer PowerShell for VS 2026.",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "linux-clang",
      "displayName": "Linux - Ninja + Clang",
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "description": "Clang 17 or newer (C++26).",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux - Ninja + GCC",
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "description": "GCC 14 or newer (C++26).",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "macos",
      "displayName": "macOS - Ninja + Apple Clang",
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "description": "Vulkan through MoltenVK until the native Metal backend exists."
    }
  ],
  "buildPresets": [
    {
      "name": "windows-vs2026-debug",
      "displayName": "Debug",
      "configurePreset": "windows-vs2026",
      "configuration": "Debug"
    },
    {
      "name": "windows-vs2026-release",
      "displayName": "Release",
      "configurePreset": "windows-vs2026",
      "configuration": "Release"
    },
    {
      "name": "windows-vs2026-distribution",
      "displayName": "Distribution",
      "configurePreset": "windows-vs2026",
      "configuration": "Distribution"
    },
    {
      "name": "windows-ninja-debug",
      "displayName": "Debug",
      "configurePreset": "windows-ninja",
      "configuration": "Debug"
    },
    {
      "name": "windows-ninja-release",
      "displayName": "Release",
      "configurePreset": "windows-ninja",
      "configuration": "Release"
    },
    {
      "name": "windows-ninja-distribution",
      "displayName": "Distribution",
      "configurePreset": "windows-ninja",
      "configuration": "Distribution"
    },
    {
      "name": "linux-clang-debug",
      "displayName": "Debug",
      "configurePreset": "linux-clang",
      "configuration": "Debug"
    },
    {
      "name": "linux-clang-release",
      "displayName": "Release",
      "configurePreset": "linux-clang",
      "configuration": "Release"
    },
    {
      "name": "linux-clang-distribution",
      "displayName": "Distribution",
      "configurePreset": "linux-clang",
      "configuration": "Distribution"
    },
    {
      "name": "linux-gcc-debug",
      "displayName": "Debug",
      "configurePreset": "linux-gcc",
      "configuration": "Debug"
    },
    {
      "name": "linux-gcc-release",
      "displayName": "Release",
      "configurePreset": "linux-gcc",
      "configuration": "Release"
    },
    {
      "name": "linux-gcc-distribution",
      "displayName": "Distribution",
      "configurePreset": "linux-gcc",
      "configuration": "Distribution"
    },
    {
      "name": "macos-debug",
      "displayName": "Debug",
      "configurePreset": "macos",
      "configuration": "Debug"
    },
    {
      "name": "macos-release",
      "displayName": "Release",
      "configurePreset": "macos",
      "configuration": "Release"
    },
    {
      "name": "macos-distribution",
      "displayName": "Distribution",
      "configurePreset": "macos",
      "configuration": "Distribution"
    }
  ]
}