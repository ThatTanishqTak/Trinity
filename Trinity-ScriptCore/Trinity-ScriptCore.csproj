<Project Sdk="Microsoft.NET.Sdk">

	<!-- The managed API C# scripts build against. The engine starts .NET from its runtime config, loads it into the default load context and calls its [UnmanagedCallersOnly] entry points through function pointers. CMake builds it with dotnet into bin/<configuration>/Trinity/Scripting -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>Trinity-ScriptCore</AssemblyName>
		<RootNamespace>Trinity</RootNamespace>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<EnableDynamicLoading>true</EnableDynamicLoading>
		<IsAotCompatible>true</IsAotCompatible>
		<Deterministic>true</Deterministic>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
	</PropertyGroup>

	<!-- The bindings Trinity-InteropGen writes from NativeFunctions.def. CMake's builds pass their folder, and an IDE finds the Debug one through the props CMake writes beside the project -->
	<Import Project="Trinity-ScriptCore.Local.props" Condition="Exists('Trinity-ScriptCore.Local.props')" />

	<ItemGroup Condition="'$(TrinityGeneratedDirectory)' != ''">
		<Compile Include="$(TrinityGeneratedDirectory)/*.cs" />
	</ItemGroup>

	<!-- Beside ScriptCore, for Forge's NativeAOT publish of a game's scripts against it -->
	<ItemGroup>
		<None Update="Trinity-ScriptCore.Aot.targets" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>