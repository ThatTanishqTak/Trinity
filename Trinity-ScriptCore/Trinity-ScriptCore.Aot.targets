<Project>

	<!-- Imported by Forge's NativeAOT publish of a game's scripts, to export ScriptCore's way in -->
	<ItemGroup>
		<UnmanagedEntryPointsAssembly Include="Trinity-ScriptCore" />
	</ItemGroup>

	<!-- A NativeAOT library compiles ScriptCore in, and keeps all of the game's assembly -->
	<ItemGroup>
		<Reference Update="Trinity-ScriptCore" Private="true" />
		<TrimmerRootAssembly Include="$(AssemblyName)" />
	</ItemGroup>

</Project>