// The engine's components and enums C# reaches, one line each. Trinity-InteropGen writes each as a Trinity.<Name> C# type from these lines as ScriptCore builds, and the engine's table of accessors and its checks come from the same lines, so the two cannot drift
//
// TR_ENUM(Name, Type) names an enum of the engine's, and TR_ENUM_VALUE(Enum, Name, Number) each of its values, which the engine checks at build time and a write from C# is held to. TR_COMPONENT(Name, Type) names a component, numbered in the order of this list, and the TR_PROPERTY(Component, Name, Kind, Member) lines after it each value of it C# reads and writes, numbered across the whole list. A property's kind is its C# type: Bool, Int32, UInt32, Float, Vector2, Vector3, Vector4, Quaternion, Color, Enum(Name) for an enum of this list, Asset(Type) for the UUID of an asset type of AssetTypes.cs, Entity for an entity's UUID, or Axes for a glm::bvec3, which C# has as Trinity.Axes flags. A Color is a glm::vec4, or a glm::vec3 whose alpha reads as 1. What does not fit a kind, such as a list, is written by hand on both sides

TR_ENUM(ScriptLanguage, ScriptLanguage)
TR_ENUM_VALUE(ScriptLanguage, Cpp, 0)
TR_ENUM_VALUE(ScriptLanguage, CSharp, 1)

TR_ENUM(CameraProjection, CameraProjection)
TR_ENUM_VALUE(CameraProjection, Orthographic, 0)
TR_ENUM_VALUE(CameraProjection, Perspective, 1)

TR_ENUM(Tonemapper, Tonemapper)
TR_ENUM_VALUE(Tonemapper, None, 0)
TR_ENUM_VALUE(Tonemapper, PBRNeutral, 1)

TR_ENUM(LightType, LightType)
TR_ENUM_VALUE(LightType, Directional, 0)
TR_ENUM_VALUE(LightType, Point, 1)
TR_ENUM_VALUE(LightType, Spot, 2)

TR_ENUM(BodyMotion, BodyMotion)
TR_ENUM_VALUE(BodyMotion, Static, 0)
TR_ENUM_VALUE(BodyMotion, Kinematic, 1)
TR_ENUM_VALUE(BodyMotion, Dynamic, 2)

TR_ENUM(JointType, JointType)
TR_ENUM_VALUE(JointType, Fixed, 0)
TR_ENUM_VALUE(JointType, Hinge, 1)
TR_ENUM_VALUE(JointType, Slider, 2)
TR_ENUM_VALUE(JointType, Distance, 3)
TR_ENUM_VALUE(JointType, Point, 4)

TR_ENUM(Joint2DType, Joint2DType)
TR_ENUM_VALUE(Joint2DType, Revolute, 0)
TR_ENUM_VALUE(Joint2DType, Prismatic, 1)
TR_ENUM_VALUE(Joint2DType, Distance, 2)
TR_ENUM_VALUE(Joint2DType, Weld, 3)
TR_ENUM_VALUE(Joint2DType, Wheel, 4)

TR_ENUM(QueryShapeType, PhysicsQueryShapeType3D)
TR_ENUM_VALUE(QueryShapeType, Sphere, 0)
TR_ENUM_VALUE(QueryShapeType, Box, 1)
TR_ENUM_VALUE(QueryShapeType, Capsule, 2)

TR_ENUM(QueryShape2DType, PhysicsQueryShapeType2D)
TR_ENUM_VALUE(QueryShape2DType, Circle, 0)
TR_ENUM_VALUE(QueryShape2DType, Box, 1)
TR_ENUM_VALUE(QueryShape2DType, Capsule, 2)

