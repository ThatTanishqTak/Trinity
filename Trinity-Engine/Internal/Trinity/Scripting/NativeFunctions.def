
// Every engine function C# can call, one line each, in the order the table holds them: TR_NATIVE(Name, Return, (Parameters)). The engine's table comes from these lines through Interop.hpp, and Trinity-InteropGen writes the matching C# from them as ScriptCore builds, so the two cannot drift. Each function is defined in Trinity::Interop, in the source of its area
//
// The types are those of Interop.hpp: Void, Bool, Int32, UInt32, Int64, UInt64, Float, Double, EntityId, LogLevel and Utf8 by value, and the vectors, Quaternion, Color, Matrix4x4, FieldValue, Collision and the physics query types only through pointers, since MSVC passes a glm type with constructors differently from a C struct

TR_NATIVE(Log_Write, Void, (LogLevel level, Utf8 text))
TR_NATIVE(Interop_Echo, Int32, (Int32 value))

// A C# assembly's script classes, which ScriptCore describes one at a time as the assembly loads: its name and callbacks, then each field with its default, a list's default elements and an enum field's values after it, then the end, which registers the class and says whether it was taken
TR_NATIVE(Scripting_BeginClass, Void, (Utf8 name, UInt32 callbacks))
TR_NATIVE(Scripting_AddField, Void, (Utf8 name, const FieldValue* value, Utf8 assetType))
TR_NATIVE(Scripting_AddListElement, Void, (const FieldValue* value))
TR_NATIVE(Scripting_AddEnumValue, Void, (Utf8 name, Int64 value))
TR_NATIVE(Scripting_EndClass, Bool, ())

// The running scene's entities, by UUID, 0 for none. A name crosses as Utf8, which C# copies at once
TR_NATIVE(Entity_Exists, Bool, (EntityId entity))
TR_NATIVE(Entity_FindByName, EntityId, (Utf8 name))
TR_NATIVE(Entity_Create, EntityId, (Utf8 name, EntityId parent))
TR_NATIVE(Entity_Destroy, Bool, (EntityId entity))
TR_NATIVE(Entity_Duplicate, EntityId, (EntityId entity))
TR_NATIVE(Entity_Instantiate, EntityId, (UInt64 prefab, EntityId parent, const Vector3* position, const Quaternion* rotation))
TR_NATIVE(Entity_GetName, Utf8, (EntityId entity))
TR_NATIVE(Entity_SetName, Bool, (EntityId entity, Utf8 name))
TR_NATIVE(Entity_GetParent, EntityId, (EntityId entity))
TR_NATIVE(Entity_SetParent, Bool, (EntityId entity, EntityId parent, Bool keepWorldTransform))
TR_NATIVE(Entity_GetFirstChild, EntityId, (EntityId entity))
TR_NATIVE(Entity_GetNextSibling, EntityId, (EntityId entity))
TR_NATIVE(Entity_GetChildCount, UInt32, (EntityId entity))
TR_NATIVE(Transform_GetWorld, Bool, (EntityId entity, Vector3* position, Quaternion* rotation, Vector3* scale))
TR_NATIVE(Transform_SetWorld, Bool, (EntityId entity, const Vector3* position, const Quaternion* rotation, const Vector3* scale))

// The components of ScriptComponents.def, by their number there, and each property by its number across the list. Each Int32 result is an Interop::AccessResult
TR_NATIVE(Component_Has, Bool, (EntityId entity, Int32 component))
TR_NATIVE(Component_Add, Int32, (EntityId entity, Int32 component))
TR_NATIVE(Component_Remove, Int32, (EntityId entity, Int32 component))
TR_NATIVE(Component_Get, Int32, (EntityId entity, Int32 property, FieldValue* value))
TR_NATIVE(Component_Set, Int32, (EntityId entity, Int32 property, const FieldValue* value))
TR_NATIVE(MeshRenderer_GetMaterialCount, Int32, (EntityId entity))
TR_NATIVE(MeshRenderer_GetMaterial, UInt64, (EntityId entity, Int32 slot))
TR_NATIVE(MeshRenderer_SetMaterial, Int32, (EntityId entity, Int32 slot, UInt64 material))
TR_NATIVE(PolygonCollider2D_GetPointCount, Int32, (EntityId entity))
TR_NATIVE(PolygonCollider2D_GetPoint, Bool, (EntityId entity, Int32 index, Vector2* point))
TR_NATIVE(PolygonCollider2D_SetPoints, Int32, (EntityId entity, const Vector2* points, Int32 count))

// The scripts on an entity, by their index in its Script component, and the language as a ScriptLanguage. An instance is a GC handle for C#
TR_NATIVE(Scripting_GetScriptCount, Int32, (EntityId entity))
TR_NATIVE(Scripting_GetInstance, Int64, (EntityId entity, Int32 index, Int32 language))
TR_NATIVE(Scripting_FindScript, Int32, (EntityId entity, Int32 language, Utf8 className))
TR_NATIVE(Scripting_AddScript, Int32, (EntityId entity, Int32 language, Utf8 className))
TR_NATIVE(Scripting_RemoveScript, Bool, (EntityId entity, Int32 index))

// A C# script's timers and coroutines, kept by the running scene's runtime, as ScriptRuntime::StartTask has them: the owner is the script's instance, the task a GC handle to what ScriptCore runs it through, its kind a ScriptTaskKind, and its first wait a ScriptWaitType with its seconds or frames. A timer's interval is in seconds, 0 for one that runs once. 0 when no scene runs, with the task freed
TR_NATIVE(Scripting_StartTask, UInt64, (Int64 owner, Int64 task, Int32 kind, Int32 waitType, Float seconds, Int32 frames, Float interval))
TR_NATIVE(Scripting_StopTask, Bool, (UInt64 task))
TR_NATIVE(Scripting_StopTasks, Int32, (Int64 owner, Int32 kind))
TR_NATIVE(Scripting_IsTaskRunning, Bool, (UInt64 task))

// Scenes as SceneManager loads and switches them, by a scene asset's UUID or its path in the project. Each Load is false, logged, for a scene there is not or when no SceneManager runs
TR_NATIVE(SceneManager_Load, Bool, (UInt64 scene))
TR_NATIVE(SceneManager_LoadPath, Bool, (Utf8 path))
TR_NATIVE(SceneManager_IsLoading, Bool, ())
TR_NATIVE(SceneManager_GetScene, UInt64, ())

// The running scene's clock, as ScriptTime has it
TR_NATIVE(Time_GetDeltaTime, Float, ())
TR_NATIVE(Time_GetFixedDeltaTime, Float, ())
TR_NATIVE(Time_GetElapsed, Double, ())
TR_NATIVE(Time_GetFrameCount, UInt64, ())
TR_NATIVE(Time_GetStepCount, UInt64, ())

// Keys and mouse buttons by their KeyCode and MouseCode numbers
TR_NATIVE(Input_IsKeyPressed, Bool, (Int32 key))
TR_NATIVE(Input_WasKeyPressed, Bool, (Int32 key))
TR_NATIVE(Input_WasKeyReleased, Bool, (Int32 key))
TR_NATIVE(Input_IsMouseButtonPressed, Bool, (Int32 button))
TR_NATIVE(Input_WasMouseButtonPressed, Bool, (Int32 button))
TR_NATIVE(Input_WasMouseButtonReleased, Bool, (Int32 button))
TR_NATIVE(Input_GetMousePosition, Void, (Vector2* position))
TR_NATIVE(Input_GetMouseDelta, Void, (Vector2* delta))
TR_NATIVE(Input_GetMouseScroll, Void, (Vector2* scroll))

// Gamepads by their slot in Input, and their buttons and axes by their GamepadButton and GamepadAxis numbers. A name crosses as Utf8, which C# copies at once
TR_NATIVE(Input_GetMaxGamepads, Int32, ())
TR_NATIVE(Input_IsGamepadConnected, Bool, (Int32 gamepad))
TR_NATIVE(Input_GetGamepadName, Utf8, (Int32 gamepad))
TR_NATIVE(Input_IsGamepadButtonPressed, Bool, (Int32 gamepad, Int32 button))
TR_NATIVE(Input_WasGamepadButtonPressed, Bool, (Int32 gamepad, Int32 button))
TR_NATIVE(Input_WasGamepadButtonReleased, Bool, (Int32 gamepad, Int32 button))
TR_NATIVE(Input_GetGamepadAxis, Float, (Int32 gamepad, Int32 axis))
TR_NATIVE(Input_SetGamepadRumble, Void, (Int32 gamepad, Float lowFrequency, Float highFrequency))
TR_NATIVE(Input_StopGamepadRumble, Void, ())

// The running scene's input actions, as InputAction and InputActions have them. An action crosses as its handle, 0 for one never found, a path or a map's name as Utf8, and a device as its InputDevice number. A player is numbered from 0, and -1 is no player both ways. An action's edges are a byte of players each, bit 0 for player 0, for those it went down for this frame, then went up for, performed for and canceled for, or -1 for a handle the running scene did not find
TR_NATIVE(InputAction_Find, UInt64, (Utf8 path))
TR_NATIVE(InputAction_IsValid, Bool, (UInt64 action))
TR_NATIVE(InputAction_IsPressed, Bool, (UInt64 action, Int32 player))
TR_NATIVE(InputAction_WasPressed, Bool, (UInt64 action, Int32 player))
TR_NATIVE(InputAction_WasReleased, Bool, (UInt64 action, Int32 player))
TR_NATIVE(InputAction_WasPerformed, Bool, (UInt64 action, Int32 player))
TR_NATIVE(InputAction_WasCanceled, Bool, (UInt64 action, Int32 player))
TR_NATIVE(InputAction_ReadProgress, Float, (UInt64 action, Int32 player))
TR_NATIVE(InputAction_ReadValue, Float, (UInt64 action, Int32 player))
TR_NATIVE(InputAction_ReadVector2, Void, (UInt64 action, Int32 player, Vector2* value))
TR_NATIVE(InputAction_GetEdges, Int64, (UInt64 action))

// An action's bindings and a player's rebinds of them, a binding and a part by index, and a source by its name, such as Keyboard/Space, empty for none. A rebind crosses as its handle, 0 for none, and its state as its InputRebindState number. A name crosses as Utf8, valid until the next call that gives one, which C# copies at once
TR_NATIVE(InputAction_GetBindingCount, Int32, (UInt64 action))
TR_NATIVE(InputAction_GetPartCount, Int32, (UInt64 action, Int32 binding))
TR_NATIVE(InputAction_GetSource, Utf8, (UInt64 action, Int32 binding, Int32 part, Int32 player, Bool asset))
TR_NATIVE(InputAction_Rebind, UInt64, (UInt64 action, Int32 binding, Int32 part, Utf8 source, Int32 player))
TR_NATIVE(InputAction_StartRebind, UInt64, (UInt64 action, Int32 binding, Int32 part, Int32 player))
TR_NATIVE(InputAction_ResetBinding, Void, (UInt64 action, Int32 binding, Int32 part, Int32 player))
TR_NATIVE(InputRebind_GetState, Int32, (UInt64 rebind))
TR_NATIVE(InputRebind_GetSource, Utf8, (UInt64 rebind))
TR_NATIVE(InputRebind_GetConflict, Utf8, (UInt64 rebind))
TR_NATIVE(InputRebind_Cancel, Void, (UInt64 rebind))

TR_NATIVE(InputActions_GetMaxPlayers, Int32, ())
TR_NATIVE(InputActions_GetPressPoint, Float, ())
TR_NATIVE(InputActions_GetAsset, UInt64, ())
TR_NATIVE(InputActions_IsReady, Bool, ())
TR_NATIVE(InputActions_EnableMap, Bool, (Utf8 map, Int32 player))
TR_NATIVE(InputActions_DisableMap, Bool, (Utf8 map, Int32 player))
TR_NATIVE(InputActions_IsMapEnabled, Bool, (Utf8 map, Int32 player))
TR_NATIVE(InputActions_AddPlayer, Int32, ())
TR_NATIVE(InputActions_RemovePlayer, Void, (Int32 player))
TR_NATIVE(InputActions_IsPlayer, Bool, (Int32 player))
TR_NATIVE(InputActions_GetPlayerCount, Int32, ())
TR_NATIVE(InputActions_AssignDevice, Bool, (Int32 device, Int32 player))
TR_NATIVE(InputActions_UnassignDevice, Void, (Int32 device))
TR_NATIVE(InputActions_GetDevicePlayer, Int32, (Int32 device))
TR_NATIVE(InputActions_ReadsDevice, Bool, (Int32 player, Int32 device))
TR_NATIVE(InputActions_GetJoiningDevice, Int32, ())
TR_NATIVE(InputActions_ResetBindings, Void, (Int32 player))

// What a script does to the body an entity is part of, named by the entity that owns it or by one of its colliders' entities, in world space, as PhysicsScene3D and 2D do it. Each Int32 result is an Interop::AccessResult: NoComponent for an entity that is not part of a body the running scene's physics has made, and BadValue for a body whose motion does not take it. A null point pushes at the body's centre of mass. A 2D body's turns are counter-clockwise radians about Z
TR_NATIVE(Body_GetVelocity, Int32, (EntityId entity, Vector3* linear, Vector3* angular))
TR_NATIVE(Body_SetLinearVelocity, Int32, (EntityId entity, const Vector3* velocity))
TR_NATIVE(Body_SetAngularVelocity, Int32, (EntityId entity, const Vector3* velocity))
TR_NATIVE(Body_AddForce, Int32, (EntityId entity, const Vector3* force, const Vector3* point))
TR_NATIVE(Body_AddTorque, Int32, (EntityId entity, const Vector3* torque))
TR_NATIVE(Body_AddImpulse, Int32, (EntityId entity, const Vector3* impulse, const Vector3* point))
TR_NATIVE(Body_AddAngularImpulse, Int32, (EntityId entity, const Vector3* impulse))
TR_NATIVE(Body_Teleport, Int32, (EntityId entity, const Vector3* position, const Quaternion* rotation))
TR_NATIVE(Body_MoveKinematic, Int32, (EntityId entity, const Vector3* position, const Quaternion* rotation))
TR_NATIVE(Body_SetAwake, Int32, (EntityId entity, Bool awake))
TR_NATIVE(Body_IsAwake, Int32, (EntityId entity, Bool* awake))
TR_NATIVE(Joint_IsBroken, Int32, (EntityId entity, Bool* broken))
TR_NATIVE(Body2D_GetVelocity, Int32, (EntityId entity, Vector2* linear, Float* angular))
TR_NATIVE(Body2D_SetLinearVelocity, Int32, (EntityId entity, const Vector2* velocity))
TR_NATIVE(Body2D_SetAngularVelocity, Int32, (EntityId entity, Float velocity))
TR_NATIVE(Body2D_AddForce, Int32, (EntityId entity, const Vector2* force, const Vector2* point))
TR_NATIVE(Body2D_AddTorque, Int32, (EntityId entity, Float torque))
TR_NATIVE(Body2D_AddImpulse, Int32, (EntityId entity, const Vector2* impulse, const Vector2* point))
TR_NATIVE(Body2D_AddAngularImpulse, Int32, (EntityId entity, Float impulse))
TR_NATIVE(Body2D_Teleport, Int32, (EntityId entity, const Vector2* position, Float angle))
TR_NATIVE(Body2D_MoveKinematic, Int32, (EntityId entity, const Vector2* position, Float angle))
TR_NATIVE(Body2D_SetAwake, Int32, (EntityId entity, Bool awake))
TR_NATIVE(Body2D_IsAwake, Int32, (EntityId entity, Bool* awake))
TR_NATIVE(Joint2D_IsBroken, Int32, (EntityId entity, Bool* broken))

// What a script does to a character, named by its entity or one of its colliders' entities, as PhysicsScene3D and 2D do it: its own velocity, which lasts until changed, a move its next step covers besides that velocity, and the ground as its last step left it, with 0 for no ground entity. Each Int32 result is an Interop::AccessResult: NoComponent for an entity that is part of nothing the running scene's physics has made, and BadValue for one that is part of a body and not a character. A character teleports through Body_Teleport and Body2D_Teleport
TR_NATIVE(Character_GetVelocity, Int32, (EntityId entity, Vector3* velocity))
TR_NATIVE(Character_SetVelocity, Int32, (EntityId entity, const Vector3* velocity))
TR_NATIVE(Character_Move, Int32, (EntityId entity, const Vector3* displacement))
TR_NATIVE(Character_GetGround, Int32, (EntityId entity, Bool* grounded, Vector3* normal, Vector3* velocity, EntityId* ground))
TR_NATIVE(Character2D_GetVelocity, Int32, (EntityId entity, Vector2* velocity))
TR_NATIVE(Character2D_SetVelocity, Int32, (EntityId entity, const Vector2* velocity))
TR_NATIVE(Character2D_Move, Int32, (EntityId entity, const Vector2* displacement))
TR_NATIVE(Character2D_GetGround, Int32, (EntityId entity, Bool* grounded, Vector2* normal, Vector2* velocity, EntityId* ground))

// The running scene's queries, as PhysicsScene3D and 2D answer them, into the caller's hits: the nearest alone, or with all every one met, nearest first, as many as there is room for. Each returns how many it wrote, 0 when the scene has no physics, or -1 for a shape type the engine does not know
TR_NATIVE(Physics_Raycast, Int32, (const Vector3* origin, const Vector3* direction, Float maxDistance, const QueryFilter* filter, Bool all, PhysicsHit* hits, Int32 capacity))
TR_NATIVE(Physics_ShapeCast, Int32, (const QueryShape* shape, const Vector3* position, const Quaternion* rotation, const Vector3* direction, Float maxDistance, const QueryFilter* filter, Bool all, PhysicsHit* hits, Int32 capacity))
TR_NATIVE(Physics_Overlap, Int32, (const QueryShape* shape, const Vector3* position, const Quaternion* rotation, const QueryFilter* filter, PhysicsHit* hits, Int32 capacity))
TR_NATIVE(Physics2D_Raycast, Int32, (const Vector2* origin, const Vector2* direction, Float maxDistance, const QueryFilter* filter, Bool all, PhysicsHit2D* hits, Int32 capacity))
TR_NATIVE(Physics2D_ShapeCast, Int32, (const QueryShape2D* shape, const Vector2* position, Float angle, const Vector2* direction, Float maxDistance, const QueryFilter* filter, Bool all, PhysicsHit2D* hits, Int32 capacity))
TR_NATIVE(Physics2D_Overlap, Int32, (const QueryShape2D* shape, const Vector2* position, Float angle, const QueryFilter* filter, PhysicsHit2D* hits, Int32 capacity))

// Lines for this frame, as DebugDraw draws them, none in Distribution
TR_NATIVE(DebugDraw_Line, Void, (const Vector3* from, const Vector3* to, const Color* color, Bool onTop))
TR_NATIVE(DebugDraw_Box, Void, (const Matrix4x4* transform, const Color* color, Bool onTop))
TR_NATIVE(DebugDraw_AxisBox, Void, (const Vector3* center, const Vector3* halfExtents, const Color* color, Bool onTop))
TR_NATIVE(DebugDraw_Circle, Void, (const Vector3* center, const Vector3* normal, Float radius, const Color* color, Bool onTop))
TR_NATIVE(DebugDraw_Sphere, Void, (const Vector3* center, Float radius, const Color* color, Bool onTop))
TR_NATIVE(DebugDraw_Capsule, Void, (const Vector3* start, const Vector3* end, Float radius, const Color* color, Bool onTop))
TR_NATIVE(DebugDraw_Arrow, Void, (const Vector3* from, const Vector3* to, const Color* color, Bool onTop))
TR_NATIVE(DebugDraw_Cross, Void, (const Vector3* center, Float size, const Color* color, Bool onTop))

// The running scene's sounds, as AudioScene plays them: an AudioSource by its entity, each Int32 result an Interop::AccessResult, NoComponent for an entity with no AudioSource, and a sound played on its own by its handle, 0 for none, which once its sound has ended reaches nothing, so every call on it does nothing. A resource is the UUID of an AudioClip or a Sound Event, 0 for the source's own, and a parameter, a label or a name crosses as Utf8. A found result is false, its value left as it was, for a parameter, a label or a value there is not. Each does nothing, or reads as nothing playing, while no scene runs
TR_NATIVE(AudioSource_Play, Int32, (EntityId entity))
TR_NATIVE(AudioSource_Stop, Int32, (EntityId entity))
TR_NATIVE(AudioSource_Pause, Int32, (EntityId entity))
TR_NATIVE(AudioSource_UnPause, Int32, (EntityId entity))
TR_NATIVE(AudioSource_IsPlaying, Int32, (EntityId entity, Bool* playing))
TR_NATIVE(AudioSource_GetTime, Int32, (EntityId entity, Double* time))
TR_NATIVE(AudioSource_PlayOneShot, Int32, (EntityId entity, UInt64 resource, Float volumeScale, UInt64* handle))
TR_NATIVE(AudioSource_SetParameter, Int32, (EntityId entity, Utf8 name, Float value))
TR_NATIVE(AudioSource_SetParameterLabel, Int32, (EntityId entity, Utf8 name, Utf8 label, Bool* found))
TR_NATIVE(AudioSource_GetParameter, Int32, (EntityId entity, Utf8 name, Float* value, Bool* found))
TR_NATIVE(AudioSource_GetOutput, Int32, (EntityId entity, UInt64* group))
TR_NATIVE(AudioSource_SetOutput, Int32, (EntityId entity, UInt64 group))
TR_NATIVE(Audio_PlayAtPoint, UInt64, (UInt64 resource, const Vector3* position, Float volume))
TR_NATIVE(Audio_PlayAttached, UInt64, (UInt64 resource, EntityId entity, Float volume))
TR_NATIVE(Audio_SetGlobalParameter, Bool, (Utf8 name, Float value))
TR_NATIVE(Audio_GetGlobalParameter, Bool, (Utf8 name, Float* value))
TR_NATIVE(AudioHandle_Stop, Void, (UInt64 handle, Float fadeSeconds))
TR_NATIVE(AudioHandle_IsPlaying, Bool, (UInt64 handle))
TR_NATIVE(AudioHandle_GetTime, Double, (UInt64 handle))
TR_NATIVE(AudioHandle_SetParameter, Bool, (UInt64 handle, Utf8 name, Float value))
TR_NATIVE(AudioHandle_SetParameterLabel, Bool, (UInt64 handle, Utf8 name, Utf8 label))
TR_NATIVE(AudioHandle_GetParameter, Bool, (UInt64 handle, Utf8 name, Float* value))
TR_NATIVE(AudioHandle_SetPosition, Void, (UInt64 handle, const Vector3* position))
TR_NATIVE(AudioHandle_Follow, Void, (UInt64 handle, EntityId entity))

// The project's mixer, which the running scene plays through, named by its asset's UUID, 0 for the project's own. One named that is not the project's is refused with one warning. A group crosses as its ID, 0 for none, which plays into Master
TR_NATIVE(AudioMixer_GetAsset, UInt64, ())
TR_NATIVE(AudioMixer_SetFloat, Bool, (UInt64 mixer, Utf8 name, Float value))
TR_NATIVE(AudioMixer_GetFloat, Bool, (UInt64 mixer, Utf8 name, Float* value))
TR_NATIVE(AudioMixer_ClearFloat, Bool, (UInt64 mixer, Utf8 name))
TR_NATIVE(AudioMixer_TransitionToSnapshot, Bool, (UInt64 mixer, Utf8 name, Float seconds))
TR_NATIVE(AudioMixer_FindGroup, UInt64, (UInt64 mixer, Utf8 name))

// The game's end, as Application::Quit has it: a player closes once the frame ends, and Forge stops playing
TR_NATIVE(Application_Quit, Void, ())