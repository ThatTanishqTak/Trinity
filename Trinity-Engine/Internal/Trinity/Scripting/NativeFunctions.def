// Every engine function C# can call, one line each, in the order the table holds them: TR_NATIVE(Name, Return, (Parameters)). The engine's table comes from these lines through Interop.hpp, and Trinity-InteropGen writes the matching C# from them as ScriptCore builds, so the two cannot drift. Each function is defined in Trinity::Interop, in the source of its area
//
// The types are those of Interop.hpp: Void, Bool, Int32, UInt32, Int64, UInt64, Float, Double, EntityId, LogLevel and Utf8 by value, and the vectors, Quaternion, Color, Matrix4x4, FieldValue, Collision and the physics query types only through pointers, since MSVC passes a glm type with constructors differently from a C struct

TR_NATIVE(Log_Write, Void, (LogLevel level, Utf8 text))
TR_NATIVE(Interop_Echo, Int32, (Int32 value))

// A C# assembly's script classes, which ScriptCore describes one at a time as the assembly loads: its name and callbacks, then each field with its default, and an enum field's values after it, then the end, which registers the class and says whether it was taken
TR_NATIVE(Scripting_BeginClass, Void, (Utf8 name, UInt32 callbacks))
TR_NATIVE(Scripting_AddField, Void, (Utf8 name, const FieldValue* value, Utf8 assetType))
TR_NATIVE(Scripting_AddEnumValue, Void, (Utf8 name, Int64 value))
TR_NATIVE(Scripting_EndClass, Bool, ())

// The running scene's entities, by UUID, 0 for none. A name crosses as Utf8, which C# copies at once
TR_NATIVE(Entity_Exists, Bool, (EntityId entity))
TR_NATIVE(Entity_FindByName, EntityId, (Utf8 name))
TR_NATIVE(Entity_Create, EntityId, (Utf8 name, EntityId parent))
TR_NATIVE(Entity_Destroy, Bool, (EntityId entity))
TR_NATIVE(Entity_Duplicate, EntityId, (EntityId entity))
TR_NATIVE(Entity_GetName, Utf8, (EntityId entity))
TR_NATIVE(Entity_SetName, Bool, (EntityId entity, Utf8 name))
TR_NATIVE(Entity_GetParent, EntityId, (EntityId entity))
TR_NATIVE(Entity_SetParent, Bool, (EntityId entity, EntityId parent, Bool keepWorldTransform))
TR_NATIVE(Entity_GetFirstChild, EntityId, (EntityId entity))
TR_NATIVE(Entity_GetNextSibling, EntityId, (EntityId entity))
TR_NATIVE(Entity_GetChildCount, UInt32, (EntityId entity))
TR_NATIVE(Transform_GetWorld, Bool, (EntityId entity, Vector3* position, Quaternion* rotation, Vector3* scale))
TR_NATIVE(Transform_SetWorld, Bool, (EntityId entity, const Vector3* position, const Quaternion* rotation, const Vector3* scale))

// The components of ScriptComponents.def, by their number there, and each property by its number across the list. Each Int32 result is an Interop::AccessResult
TR_NATIVE(Component_Has, Bool, (EntityId entity, Int32 component))
TR_NATIVE(Component_Add, Int32, (EntityId entity, Int32 component))
TR_NATIVE(Component_Remove, Int32, (EntityId entity, Int32 component))
TR_NATIVE(Component_Get, Int32, (EntityId entity, Int32 property, FieldValue* value))
TR_NATIVE(Component_Set, Int32, (EntityId entity, Int32 property, const FieldValue* value))
TR_NATIVE(MeshRenderer_GetMaterialCount, Int32, (EntityId entity))
TR_NATIVE(MeshRenderer_GetMaterial, UInt64, (EntityId entity, Int32 slot))
TR_NATIVE(MeshRenderer_SetMaterial, Int32, (EntityId entity, Int32 slot, UInt64 material))
TR_NATIVE(PolygonCollider2D_GetPointCount, Int32, (EntityId entity))
TR_NATIVE(PolygonCollider2D_GetPoint, Bool, (EntityId entity, Int32 index, Vector2* point))
TR_NATIVE(PolygonCollider2D_SetPoints, Int32, (EntityId entity, const Vector2* points, Int32 count))

// The scripts on an entity, by their index in its Script component, and the language as a ScriptLanguage. An instance is a GC handle for C#
TR_NATIVE(Scripting_GetScriptCount, Int32, (EntityId entity))
TR_NATIVE(Scripting_GetInstance, Int64, (EntityId entity, Int32 index, Int32 language))
TR_NATIVE(Scripting_FindScript, Int32, (EntityId entity, Int32 language, Utf8 className))
TR_NATIVE(Scripting_AddScript, Int32, (EntityId entity, Int32 language, Utf8 className))
TR_NATIVE(Scripting_RemoveScript, Bool, (EntityId entity, Int32 index))

// The running scene's clock, as ScriptTime has it
TR_NATIVE(Time_GetDeltaTime, Float, ())
TR_NATIVE(Time_GetFixedDeltaTime, Float, ())
TR_NATIVE(Time_GetElapsed, Double, ())
TR_NATIVE(Time_GetFrameCount, UInt64, ())
TR_NATIVE(Time_GetStepCount, UInt64, ())

// Keys and mouse buttons by their KeyCode and MouseCode numbers
TR_NATIVE(Input_IsKeyPressed, Bool, (Int32 key))
TR_NATIVE(Input_WasKeyPressed, Bool, (Int32 key))
TR_NATIVE(Input_WasKeyReleased, Bool, (Int32 key))
TR_NATIVE(Input_IsMouseButtonPressed, Bool, (Int32 button))
TR_NATIVE(Input_WasMouseButtonPressed, Bool, (Int32 button))
TR_NATIVE(Input_WasMouseButtonReleased, Bool, (Int32 button))
TR_NATIVE(Input_GetMousePosition, Void, (Vector2* position))
TR_NATIVE(Input_GetMouseDelta, Void, (Vector2* delta))
TR_NATIVE(Input_GetMouseScroll, Void, (Vector2* scroll))

// What a script does to the body an entity is part of, named by the entity that owns it or by one of its colliders' entities, in world space, as PhysicsScene3D and 2D do it. Each Int32 result is an Interop::AccessResult: NoComponent for an entity that is not part of a body the running scene's physics has made, and BadValue for a body whose motion does not take it. A null point pushes at the body's centre of mass. A 2D body's turns are counter-clockwise radians about Z
TR_NATIVE(Body_GetVelocity, Int32, (EntityId entity, Vector3* linear, Vector3* angular))
TR_NATIVE(Body_SetLinearVelocity, Int32, (EntityId entity, const Vector3* velocity))
TR_NATIVE(Body_SetAngularVelocity, Int32, (EntityId entity, const Vector3* velocity))
TR_NATIVE(Body_AddForce, Int32, (EntityId entity, const Vector3* force, const Vector3* point))
TR_NATIVE(Body_AddTorque, Int32, (EntityId entity, const Vector3* torque))
TR_NATIVE(Body_AddImpulse, Int32, (EntityId entity, const Vector3* impulse, const Vector3* point))
TR_NATIVE(Body_AddAngularImpulse, Int32, (EntityId entity, const Vector3* impulse))
TR_NATIVE(Body_Teleport, Int32, (EntityId entity, const Vector3* position, const Quaternion* rotation))
TR_NATIVE(Body_MoveKinematic, Int32, (EntityId entity, const Vector3* position, const Quaternion* rotation))
TR_NATIVE(Body_SetAwake, Int32, (EntityId entity, Bool awake))
TR_NATIVE(Body_IsAwake, Int32, (EntityId entity, Bool* awake))
TR_NATIVE(Joint_IsBroken, Int32, (EntityId entity, Bool* broken))
TR_NATIVE(Body2D_GetVelocity, Int32, (EntityId entity, Vector2* linear, Float* angular))
TR_NATIVE(Body2D_SetLinearVelocity, Int32, (EntityId entity, const Vector2* velocity))
TR_NATIVE(Body2D_SetAngularVelocity, Int32, (EntityId entity, Float velocity))
TR_NATIVE(Body2D_AddForce, Int32, (EntityId entity, const Vector2* force, const Vector2* point))
TR_NATIVE(Body2D_AddTorque, Int32, (EntityId entity, Float torque))
TR_NATIVE(Body2D_AddImpulse, Int32, (EntityId entity, const Vector2* impulse, const Vector2* point))
TR_NATIVE(Body2D_AddAngularImpulse, Int32, (EntityId entity, Float impulse))
TR_NATIVE(Body2D_Teleport, Int32, (EntityId entity, const Vector2* position, Float angle))
TR_NATIVE(Body2D_MoveKinematic, Int32, (EntityId entity, const Vector2* position, Float angle))
TR_NATIVE(Body2D_SetAwake, Int32, (EntityId entity, Bool awake))
TR_NATIVE(Body2D_IsAwake, Int32, (EntityId entity, Bool* awake))
TR_NATIVE(Joint2D_IsBroken, Int32, (EntityId entity, Bool* broken))

// The running scene's queries, as PhysicsScene3D and 2D answer them, into the caller's hits: the nearest alone, or with all every one met, nearest first, as many as there is room for. Each returns how many it wrote, 0 when the scene has no physics, or -1 for a shape type the engine does not know
TR_NATIVE(Physics_Raycast, Int32, (const Vector3* origin, const Vector3* direction, Float maxDistance, const QueryFilter* filter, Bool all, PhysicsHit* hits, Int32 capacity))
TR_NATIVE(Physics_ShapeCast, Int32, (const QueryShape* shape, const Vector3* position, const Quaternion* rotation, const Vector3* direction, Float maxDistance, const QueryFilter* filter, Bool all, PhysicsHit* hits, Int32 capacity))
TR_NATIVE(Physics_Overlap, Int32, (const QueryShape* shape, const Vector3* position, const Quaternion* rotation, const QueryFilter* filter, PhysicsHit* hits, Int32 capacity))
TR_NATIVE(Physics2D_Raycast, Int32, (const Vector2* origin, const Vector2* direction, Float maxDistance, const QueryFilter* filter, Bool all, PhysicsHit2D* hits, Int32 capacity))
TR_NATIVE(Physics2D_ShapeCast, Int32, (const QueryShape2D* shape, const Vector2* position, Float angle, const Vector2* direction, Float maxDistance, const QueryFilter* filter, Bool all, PhysicsHit2D* hits, Int32 capacity))
TR_NATIVE(Physics2D_Overlap, Int32, (const QueryShape2D* shape, const Vector2* position, Float angle, const QueryFilter* filter, PhysicsHit2D* hits, Int32 capacity))

// Lines for this frame, as DebugDraw draws them, none in Distribution
TR_NATIVE(DebugDraw_Line, Void, (const Vector3* from, const Vector3* to, const Color* color, Bool onTop))
TR_NATIVE(DebugDraw_Box, Void, (const Matrix4x4* transform, const Color* color, Bool onTop))
TR_NATIVE(DebugDraw_AxisBox, Void, (const Vector3* center, const Vector3* halfExtents, const Color* color, Bool onTop))
TR_NATIVE(DebugDraw_Circle, Void, (const Vector3* center, const Vector3* normal, Float radius, const Color* color, Bool onTop))
TR_NATIVE(DebugDraw_Sphere, Void, (const Vector3* center, Float radius, const Color* color, Bool onTop))
TR_NATIVE(DebugDraw_Capsule, Void, (const Vector3* start, const Vector3* end, Float radius, const Color* color, Bool onTop))
TR_NATIVE(DebugDraw_Arrow, Void, (const Vector3* from, const Vector3* to, const Color* color, Bool onTop))
TR_NATIVE(DebugDraw_Cross, Void, (const Vector3* center, Float size, const Color* color, Bool onTop))